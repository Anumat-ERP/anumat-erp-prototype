{
  "name": "anumat-erp-prototype",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.11",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "check-types": "tsc --noEmit",
    "check:i18n": "bun scripts/audit-i18n.ts",
    "build:artifact": "tsc --noEmit && vite build --mode artifact && node scripts/build-artifact.mjs",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:storybook": "tsc --noEmit -p tsconfig.storybook.json",
    "test:storybook": "playwright test -c playwright.storybook.config.ts",
    "test:erp": "playwright test -c playwright.erp.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lottie-web": "5.13.0",
    "lucide-react": "^1.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "storybook": "10.6.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0"
  }
}
