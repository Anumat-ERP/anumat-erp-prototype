      "largeMinimumHeight": "var(--an-control-height-large) (64px)",
      "floatingLabel": "Inset resting/shrunk labels; outline legend hidden; primary focus and error tint.",
      "authentication": "Desktop 2:1 white/navy grid, 580px form cap; art hides at 767px.",
      "codeInput": "Six digits; numeric paste/autofill, typing advance, arrows, Backspace; named fieldset and digit inputs.",
      "passwordInput": "Local visibility toggle with changing label and aria-pressed.",
      "selectMenu": "MUI non-native Select replaces the browser option popup. The portal menu is anchored to the control, at most 420px or 60vh tall, with 44px rows, semantic selected/hover/focus colors, grouped choices, and keyboard navigation. Small selects use compact text and arrow spacing."
